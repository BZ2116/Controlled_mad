{
  "schema_version": 1,
  "dataset": {
    "adapter": "averitec",
    "source": "/absolute/path/to/AVeriTeC/data/dev.json"
  },
  "profiles": {
    "judge": {
      "provider": "openai",
      "model": "REPLACE_WITH_LOCKED_MODEL_ID",
      "expected_model": "REPLACE_WITH_RETURNED_MODEL_ID",
      "base_url": "https://your-provider.example/v1",
      "credential_env": "MAD_API_KEY",
      "temperature": 0.7,
      "max_tokens": 2048,
      "max_tokens_field": "max_tokens",
      "seed": null,
      "supports_seed": false,
      "context_limit": 128000,
      "timeout": 60
    }
  },
  "debate_models": [
    "judge"
  ],
  "material_model": "judge",
  "material_audit": false,
  "s0_batch": "s0-001",
  "selection_seed": 42,
  "repeats": 1,
  "history_policy": "full",
  "message_order": [
    "agent_1",
    "agent_2",
    "agent_3"
  ],
  "operations": [
    "ethos",
    "logos",
    "pathos",
    "conclusion_front",
    "conclusion_back",
    "support_first",
    "limitation_first"
  ],
  "interventions": [
    {
      "rule_id": "S_to_A_T2",
      "source_agent": "S",
      "target_agent": "A",
      "delivery_round": 2
    },
    {
      "rule_id": "A_to_B_T3",
      "source_agent": "A",
      "target_agent": "B",
      "delivery_round": 3
    }
  ],
  "diagnostics": {
    "oo": {
      "enabled": true,
      "repeats": 1
    }
  },
  "max_generation_attempts": 1,
  "max_attempts": 3,
  "budget": {
    "max_calls": 100,
    "max_tokens": 1000000,
    "stage_calls": {
      "S0": 100,
      "generate": 100,
      "annotate": 100,
      "audit": 0,
      "T1": 100,
      "T2": 100,
      "T3": 100
    }
  },
  "network_enabled": false,
  "mock_scenario": null
}
