{
  "schema_version": 1,
  "experiment": "rq2_five_round",
  "dataset": {"adapter": "averitec", "source": "../datasets/averitec/dev.json"},
  "subset": {"size": 100, "seed": 42},
  "profiles": {
    "judge": {"provider": "openai", "model": "REPLACE_WITH_LOCKED_MODEL_ID",
      "expected_model": "REPLACE_WITH_RETURNED_MODEL_ID", "base_url": "https://your-provider.example/v1",
      "credential_env": "MAD_API_KEY", "temperature": 0.7, "max_tokens": 2048,
      "max_tokens_field": "max_tokens", "seed": null, "supports_seed": false,
      "context_limit": 128000, "timeout": 60}
  },
  "debate_models": ["judge"],
  "material_model": "judge",
  "material_audit": false,
  "s0_batch": "s0-rq2-001",
  "selection_seed": 42,
  "repeats": 1,
  "history_policy": "full",
  "message_order": ["agent_1", "agent_2", "agent_3"],
  "operations": ["ethos", "logos", "pathos"],
  "interventions": [],
  "diagnostics": {"oo": {"enabled": false, "repeats": 1}},
  "max_generation_attempts": 1,
  "max_attempts": 3,
  "budget": {
    "max_calls": 10000,
    "max_tokens": 100000000,
    "stage_calls": {"S0": 1000, "generate": 1000, "annotate": 0, "audit": 0,
      "T1": 2000, "T2": 2000, "T3": 2000, "T4": 2000, "T5": 2000}
  },
  "network_enabled": false
}
